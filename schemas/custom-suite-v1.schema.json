{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/storminator89/clef-benchmark/blob/main/schemas/custom-suite-v1.schema.json",
  "title": "Clef private custom text suite v1",
  "description": "Structural authoring aid. CLI/UI additionally check UTF-8 bytes, 12-level nesting, duplicate object keys, unique case IDs, forbidden keys, native request limits and gold choices. No external resources are fetched.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "cases": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "nativeID": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$", "not": { "enum": ["constructor", "prototype", "__proto__"] } },
    "question": {
      "type": "object", "additionalProperties": false, "required": ["type", "instructions", "criteria"],
      "properties": {
        "type": { "const": "choice" },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "criteria": { "type": "object", "minProperties": 2, "maxProperties": 12, "propertyNames": { "$ref": "#/$defs/nativeID" }, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 300 } }
      }
    },
    "questions": { "type": "object", "minProperties": 1, "maxProperties": 8, "propertyNames": { "$ref": "#/$defs/nativeID" }, "additionalProperties": { "$ref": "#/$defs/question" } },
    "case": {
      "type": "object", "additionalProperties": false, "required": ["id", "state", "questions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
        "state": { "type": "string", "minLength": 1, "maxLength": 6000 },
        "questions": { "$ref": "#/$defs/questions" },
        "gold": { "type": "object", "propertyNames": { "$ref": "#/$defs/nativeID" }, "additionalProperties": { "$ref": "#/$defs/nativeID" } }
      }
    }
  }
}
